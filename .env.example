# Copy this file to .env for local use. All values below are placeholders.
# Do not put real credentials in source control.

# Presentation mode
STALE_AWARE_DEMO_MODE=1
STALE_AWARE_SIMULATED_LATENCY_MS=900

# Optional retrieval model. Leave blank for the offline lexical fallback.
STALE_AWARE_EMBEDDING_MODEL=

# Optional provider configuration for a future real semantic arbiter.
LLM_PROVIDER=none
LLM_MODEL=demo-arbiter
OPENAI_API_KEY=sk-demo-not-a-real-key
ANTHROPIC_API_KEY=demo-key-not-a-real-key

# Optional service configuration
API_HOST=127.0.0.1
API_PORT=8000
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=demo-qdrant-key-not-real
DATABASE_URL=postgresql://demo:demo@localhost:5432/stale_aware_rag
